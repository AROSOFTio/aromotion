<Window x:Class="AroMotion.App.MotionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AROMOTION Studio · Motion Editor" Height="820" Width="1320"
        MinHeight="720" MinWidth="1120" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#171A20"/>
        <SolidColorBrush x:Key="Panel2" Color="#1E222B"/>
        <SolidColorBrush x:Key="Border" Color="#2B303B"/>
        <SolidColorBrush x:Key="Muted" Color="#9DA7B8"/>
        <SolidColorBrush x:Key="Accent" Color="#6C72FF"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8ECF4"/></Style>
        <Style TargetType="Label"><Setter Property="Foreground" Value="#D7DDEA"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#252A35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#353B49"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="#0F1116"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#343A47"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="#F1F3F7"/><Setter Property="Foreground" Value="#111318"/>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E4E8F0"/><Setter Property="Margin" Value="5"/></Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111319"/><Setter Property="Foreground" Value="#E7EBF3"/>
            <Setter Property="BorderBrush" Value="#2E3440"/><Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowBackground" Value="#15181F"/><Setter Property="AlternatingRowBackground" Value="#191D25"/>
            <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
    </Window.Resources>

    <Grid Background="#0E1014">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="54"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#151820" BorderBrush="#292E38" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="AROMOTION Motion Editor" FontWeight="Bold" FontSize="22"/>
                    <TextBlock x:Name="ProjectPathText" Text="No project loaded" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Auto Generate" Background="{StaticResource Accent}" Click="AutoGenerate_Click"/>
                    <Button Content="Save Motion" Click="Save_Click"/>
                    <Button Content="Reload" Click="Reload_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="12" Background="#111319" BorderBrush="#292F3A">
            <TabItem Header="Auto Zoom">
                <Grid Background="#111319" Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Automatic focus generation" FontWeight="SemiBold" FontSize="16"/>
                                <CheckBox x:Name="ZoomClicksCheck" Content="Zoom after left-click" IsChecked="True"/>
                                <CheckBox x:Name="ZoomShortcutsCheck" Content="Zoom after keyboard shortcuts / typing focus" IsChecked="True"/>
                                <CheckBox x:Name="CursorFollowCheck" Content="Cursor-follow mode"/>
                                <CheckBox x:Name="SmartFrameCheck" Content="Smart UI framing / safe-area snap" IsChecked="True"/>
                                <CheckBox x:Name="Auto3DCheck" Content="Generate 3D motion from click focus" IsChecked="True"/>
                                <Separator Margin="0,10"/>
                                <Label Content="Default zoom scale"/><TextBox x:Name="DefaultScaleBox" Text="1.75"/>
                                <Label Content="Zoom-in duration (ms)"/><TextBox x:Name="ZoomInBox" Text="260"/>
                                <Label Content="Hold duration (ms)"/><TextBox x:Name="HoldBox" Text="1100"/>
                                <Label Content="Zoom-out duration (ms)"/><TextBox x:Name="ZoomOutBox" Text="360"/>
                                <Label Content="Merge window (ms)"/><TextBox x:Name="MergeBox" Text="520"/>
                                <Label Content="Easing"/>
                                <ComboBox x:Name="AutoEasingCombo"/>
                                <Label Content="Zoom style"/>
                                <ComboBox x:Name="AutoZoomStyleCombo"/>
                                <Label Content="Auto 3D preset"/>
                                <ComboBox x:Name="Auto3DPresetCombo"/>
                                <Label Content="3D intensity (0–1.5)"/><TextBox x:Name="Auto3DIntensityBox" Text="0.55"/>
                                <Button Content="Generate / Regenerate" Background="{StaticResource Accent}" Click="AutoGenerate_Click" Margin="3,14,3,3"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="250"/></Grid.RowDefinitions>
                        <DataGrid x:Name="ZoomGrid" SelectionChanged="ZoomGrid_SelectionChanged" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Start" Binding="{Binding StartMs}" Width="80"/>
                                <DataGridTextColumn Header="End" Binding="{Binding EndMs}" Width="80"/>
                                <DataGridTextColumn Header="Scale" Binding="{Binding Scale}" Width="70"/>
                                <DataGridTextColumn Header="Focus X" Binding="{Binding FocusX}" Width="90"/>
                                <DataGridTextColumn Header="Focus Y" Binding="{Binding FocusY}" Width="90"/>
                                <DataGridTextColumn Header="Style" Binding="{Binding Style}" Width="120"/>
                                <DataGridTextColumn Header="Easing" Binding="{Binding Easing}" Width="120"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <StackPanel Grid.Column="0"><Label Content="Start ms"/><TextBox x:Name="ZoomEditStart"/></StackPanel>
                                <StackPanel Grid.Column="1"><Label Content="Scale"/><TextBox x:Name="ZoomEditScale"/></StackPanel>
                                <StackPanel Grid.Column="2"><Label Content="Focus X"/><TextBox x:Name="ZoomEditX"/></StackPanel>
                                <StackPanel Grid.Column="3"><Label Content="Focus Y"/><TextBox x:Name="ZoomEditY"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0"><Label Content="Zoom in ms"/><TextBox x:Name="ZoomEditIn"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1"><Label Content="Hold ms"/><TextBox x:Name="ZoomEditHold"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2"><Label Content="Zoom out ms"/><TextBox x:Name="ZoomEditOut"/></StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="3"><Label Content="Easing"/><ComboBox x:Name="ZoomEditEasing"/></StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Add manual zoom" Click="AddZoom_Click"/>
                                    <Button Content="Apply changes" Background="{StaticResource Accent}" Click="ApplyZoom_Click"/>
                                    <Button Content="Delete" Click="DeleteZoom_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="3D Motion">
                <Grid Background="#111319" Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="280"/></Grid.RowDefinitions>
                    <DataGrid x:Name="Motion3DGrid" SelectionChanged="Motion3DGrid_SelectionChanged" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Start" Binding="{Binding StartMs}" Width="70"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs}" Width="80"/>
                            <DataGridTextColumn Header="Preset" Binding="{Binding Preset}" Width="100"/>
                            <DataGridTextColumn Header="Rot X" Binding="{Binding RotateX}" Width="70"/>
                            <DataGridTextColumn Header="Rot Y" Binding="{Binding RotateY}" Width="70"/>
                            <DataGridTextColumn Header="Rot Z" Binding="{Binding RotateZ}" Width="70"/>
                            <DataGridTextColumn Header="Depth" Binding="{Binding DepthZ}" Width="70"/>
                            <DataGridTextColumn Header="Pan X" Binding="{Binding PanX}" Width="70"/>
                            <DataGridTextColumn Header="Pan Y" Binding="{Binding PanY}" Width="70"/>
                            <DataGridTextColumn Header="Perspective" Binding="{Binding Perspective}" Width="90"/>
                            <DataGridTextColumn Header="Orbit" Binding="{Binding Orbit}" Width="70"/>
                            <DataGridTextColumn Header="Parallax" Binding="{Binding Parallax}" Width="80"/>
                            <DataGridTextColumn Header="Easing" Binding="{Binding Easing}" Width="100"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Margin="0,10,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <StackPanel Grid.Column="0"><Label Content="Preset"/><ComboBox x:Name="ThreeDPresetEdit" SelectionChanged="ThreeDPresetEdit_SelectionChanged"/></StackPanel>
                            <StackPanel Grid.Column="1"><Label Content="Start ms"/><TextBox x:Name="ThreeDStart"/></StackPanel>
                            <StackPanel Grid.Column="2"><Label Content="Duration ms"/><TextBox x:Name="ThreeDDuration"/></StackPanel>
                            <StackPanel Grid.Column="3"><Label Content="Hold ms"/><TextBox x:Name="ThreeDHold"/></StackPanel>
                            <StackPanel Grid.Column="4"><Label Content="Intensity"/><TextBox x:Name="ThreeDIntensity"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0"><Label Content="Rotate X"/><TextBox x:Name="ThreeDRotX"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1"><Label Content="Rotate Y"/><TextBox x:Name="ThreeDRotY"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2"><Label Content="Rotate Z"/><TextBox x:Name="ThreeDRotZ"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="3"><Label Content="Depth / Z"/><TextBox x:Name="ThreeDDepth"/></StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4"><Label Content="Perspective"/><TextBox x:Name="ThreeDPerspective"/></StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox x:Name="ThreeDShadow" Content="Shadow" IsChecked="True"/>
                                <CheckBox x:Name="ThreeDReflection" Content="Reflection"/>
                                <Button Content="Add 3D clip" Click="Add3D_Click"/>
                                <Button Content="Apply" Background="{StaticResource Accent}" Click="Apply3D_Click"/>
                                <Button Content="Delete" Click="Delete3D_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Cursor / Mouse">
                <ScrollViewer Background="#111319" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Cursor replacement" FontSize="16" FontWeight="SemiBold"/>
                                <Label Content="Cursor style"/><ComboBox x:Name="CursorStyleCombo"/>
                                <Label Content="Custom cursor path"/><TextBox x:Name="CustomCursorPathBox"/>
                                <Label Content="Cursor color"/><TextBox x:Name="CursorColorBox" Text="#FFFFFF"/>
                                <Label Content="Size"/><TextBox x:Name="CursorSizeBox" Text="1.0"/>
                                <Label Content="Opacity"/><TextBox x:Name="CursorOpacityBox" Text="1.0"/>
                                <CheckBox x:Name="CursorShadowCheck" Content="Cursor shadow" IsChecked="True"/>
                                <Label Content="Shadow opacity"/><TextBox x:Name="CursorShadowOpacityBox" Text="0.35"/>
                                <CheckBox x:Name="CursorSmoothCheck" Content="Smooth reconstructed cursor" IsChecked="True"/>
                                <Label Content="Smoothing (0–1)"/><TextBox x:Name="CursorSmoothingBox" Text="0.72"/>
                                <CheckBox x:Name="CursorMotionBlurCheck" Content="Motion blur" IsChecked="True"/>
                                <Label Content="Motion blur strength"/><TextBox x:Name="CursorMotionBlurBox" Text="0.35"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{StaticResource Panel}" CornerRadius="8" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Click effects" FontSize="16" FontWeight="SemiBold"/>
                                <Label Content="Left click ring"/><ComboBox x:Name="LeftClickStyleCombo"/>
                                <Label Content="Left click color"/><TextBox x:Name="LeftClickColorBox" Text="#5B8CFF"/>
                                <Label Content="Right click ring"/><ComboBox x:Name="RightClickStyleCombo"/>
                                <Label Content="Right click color"/><TextBox x:Name="RightClickColorBox" Text="#FF5A70"/>
                                <Label Content="Animation duration (ms)"/><TextBox x:Name="ClickDurationBox" Text="420"/>
                                <CheckBox x:Name="ClickSoundCheck" Content="Click sound" IsChecked="True"/>
                                <Label Content="Left click sound file"/><TextBox x:Name="LeftClickSoundBox"/>
                                <Label Content="Right click sound file"/><TextBox x:Name="RightClickSoundBox"/>
                                <Button Content="Apply cursor + mouse settings" Background="{StaticResource Accent}" Click="ApplyCursor_Click" Margin="3,14,3,3"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Spotlight + Privacy Blur">
                <Grid Background="#111319" Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="250"/></Grid.RowDefinitions>
                        <DataGrid x:Name="SpotlightGrid" SelectionChanged="SpotlightGrid_SelectionChanged" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Start" Binding="{Binding StartMs}" Width="70"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs}" Width="80"/>
                                <DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="110"/>
                                <DataGridTextColumn Header="Darkness" Binding="{Binding Darkness}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Follow cursor" Binding="{Binding FollowCursor}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Margin="0,8,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Spotlight" FontWeight="SemiBold"/>
                                <WrapPanel>
                                    <ComboBox x:Name="SpotlightShapeCombo" Width="140"/>
                                    <TextBox x:Name="SpotlightStart" Width="90" ToolTip="Start ms"/>
                                    <TextBox x:Name="SpotlightDuration" Width="90" Text="1500" ToolTip="Duration ms"/>
                                    <TextBox x:Name="SpotlightX" Width="75" Text="960" ToolTip="X"/>
                                    <TextBox x:Name="SpotlightY" Width="75" Text="540" ToolTip="Y"/>
                                    <TextBox x:Name="SpotlightW" Width="75" Text="460" ToolTip="Width"/>
                                    <TextBox x:Name="SpotlightH" Width="75" Text="260" ToolTip="Height"/>
                                    <TextBox x:Name="SpotlightDarkness" Width="75" Text="0.72" ToolTip="Darkness"/>
                                    <TextBox x:Name="SpotlightFeather" Width="75" Text="0.18" ToolTip="Feather"/>
                                </WrapPanel>
                                <CheckBox x:Name="SpotlightFollowCursor" Content="Follow cursor"/>
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Add" Click="AddSpotlight_Click"/>
                                    <Button Content="Apply" Background="{StaticResource Accent}" Click="ApplySpotlight_Click"/>
                                    <Button Content="Delete" Click="DeleteSpotlight_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid Grid.Column="1" Margin="6,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="250"/></Grid.RowDefinitions>
                        <DataGrid x:Name="BlurGrid" SelectionChanged="BlurGrid_SelectionChanged" IsReadOnly="True" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Start" Binding="{Binding StartMs}" Width="70"/>
                                <DataGridTextColumn Header="Duration" Binding="{Binding DurationMs}" Width="80"/>
                                <DataGridTextColumn Header="Shape" Binding="{Binding Shape}" Width="110"/>
                                <DataGridTextColumn Header="Intensity" Binding="{Binding Intensity}" Width="80"/>
                                <DataGridCheckBoxColumn Header="Track cursor" Binding="{Binding TrackCursor}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="1" Margin="0,8,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Privacy blur" FontWeight="SemiBold"/>
                                <WrapPanel>
                                    <ComboBox x:Name="BlurShapeCombo" Width="140"/>
                                    <TextBox x:Name="BlurStart" Width="90" ToolTip="Start ms"/>
                                    <TextBox x:Name="BlurDuration" Width="90" Text="1500" ToolTip="Duration ms"/>
                                    <TextBox x:Name="BlurX" Width="75" Text="720" ToolTip="X"/>
                                    <TextBox x:Name="BlurY" Width="75" Text="360" ToolTip="Y"/>
                                    <TextBox x:Name="BlurW" Width="75" Text="480" ToolTip="Width"/>
                                    <TextBox x:Name="BlurH" Width="75" Text="220" ToolTip="Height"/>
                                    <TextBox x:Name="BlurIntensity" Width="75" Text="18" ToolTip="Intensity"/>
                                    <TextBox x:Name="BlurFeather" Width="75" Text="0.12" ToolTip="Feather"/>
                                </WrapPanel>
                                <CheckBox x:Name="BlurTrackCursor" Content="Track cursor"/>
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Add" Click="AddBlur_Click"/>
                                    <Button Content="Apply" Background="{StaticResource Accent}" Click="ApplyBlur_Click"/>
                                    <Button Content="Delete" Click="DeleteBlur_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#151820" BorderBrush="#292E38" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="READY" VerticalAlignment="Center" Foreground="#9DA7B8"/>
                <TextBlock DockPanel.Dock="Right" Text="Non-destructive motion project · original lossless master remains untouched" Foreground="#697386" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
