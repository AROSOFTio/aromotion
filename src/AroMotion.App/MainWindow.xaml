<Window x:Class="AroMotion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AROMOTION Studio" Height="640" Width="980"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Grid Background="#101216">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#171A20" Padding="24,20" BorderBrush="#272B34" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="AROMOTION" Foreground="White" FontWeight="Bold" FontSize="24"/>
                    <TextBlock Text="Lossless recorder · Smart zoom · 3D motion · Cursor effects · Spotlight · Privacy blur" Foreground="#9EA7B7" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#20242C" CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatusText" Text="READY" Foreground="#B8C1D1" FontSize="12" FontWeight="SemiBold"/>
                </Border>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24">
                <TextBlock Text="Recorder" Foreground="White" FontWeight="SemiBold" FontSize="19"/>
                <TextBlock Text="Capture an untouched lossless desktop master. Cursor, clicks and shortcuts are stored separately so AROMOTION can reconstruct the cursor and generate editable motion after recording." Foreground="#A6ADBA" TextWrapping="Wrap" Margin="0,6,0,20"/>

                <Border Background="#171A20" BorderBrush="#272B34" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project folder" Foreground="#DCE1E9" VerticalAlignment="Center"/>
                        <TextBox x:Name="OutputFolderTextBox" Grid.Row="0" Grid.Column="1" Background="#0E1014" Foreground="White" BorderBrush="#323743"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Click="Browse_Click"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Capture quality" Foreground="#DCE1E9" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <ComboBox x:Name="QualityComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" Margin="4,12,4,4" Background="#0E1014" Foreground="Black">
                            <ComboBoxItem Content="Lossless Master — FFV1 / MKV (recommended)"/>
                            <ComboBoxItem Content="Lossless RGB — H.264 RGB CRF 0 / MKV"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Frame rate" Foreground="#DCE1E9" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <ComboBox x:Name="FpsComboBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="1" Margin="4,12,4,4" Background="#0E1014" Foreground="Black">
                            <ComboBoxItem Content="30"/>
                            <ComboBoxItem Content="60"/>
                            <ComboBoxItem Content="120"/>
                        </ComboBox>
                    </Grid>
                </Border>

                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="RecordButton" Grid.Column="0" Content="●  RECORD" FontWeight="Bold" FontSize="15" Padding="20,14" Click="Record_Click"/>
                    <Button x:Name="StopButton" Grid.Column="1" Content="■  STOP &amp; SAVE" FontWeight="Bold" FontSize="15" Padding="20,14" IsEnabled="False" Click="Stop_Click"/>
                </Grid>

                <Border Margin="0,20,0,0" Background="#171A20" BorderBrush="#272B34" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Session" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="MotionEditorButton" Content="Open Motion Editor" IsEnabled="False" Padding="12,5" Click="OpenMotionEditor_Click"/>
                                <Button x:Name="OpenFolderButton" Content="Open project folder" IsEnabled="False" Padding="10,4" Click="OpenFolder_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="SessionPathText" Text="No recording yet." Foreground="#9EA7B7" TextWrapping="Wrap" Margin="0,9,0,0"/>
                        <TextBlock x:Name="RecorderLogText" Text="FFmpeg has not started." Foreground="#727C8E" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,10,0,0" MaxHeight="80"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,20,0,0" Background="#151820" CornerRadius="10" Padding="16">
                    <TextBlock Foreground="#AEB7C6" TextWrapping="Wrap">
                        <Run Text="Motion note: "/><Run FontWeight="Bold" Foreground="White" Text="Effects are non-destructive."/>
                        <Run Text=" The clean master keeps the mouse unbaked. Open Motion Editor to regenerate auto-zoom, manually move/resize zoom blocks, apply 3D presets or custom values, replace/smooth the cursor, and add spotlight/privacy blur regions."/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#171A20" BorderBrush="#272B34" BorderThickness="0,1,0,0" Padding="24,12">
            <TextBlock Text="AROSOFT Innovations Ltd · AROMOTION Studio · Motion parity branch" Foreground="#697386" FontSize="11"/>
        </Border>
    </Grid>
</Window>
