<Window x:Class="AroMotion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AROMOTION Studio" Height="650" Width="960" MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" Background="#0C0F14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#202636"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#30394B"/>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#0D1016"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#30394B"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="4"/></Style>
    </Window.Resources>
    <Grid Background="#0C0F14">
        <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#131821" Padding="24,15" BorderBrush="#272F3D" BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left"><TextBlock Text="AROMOTION" Foreground="White" FontWeight="Bold" FontSize="24"/><TextBlock Text="Lossless recorder · editable zoom · 3D motion · cursor reconstruction" Foreground="#8F9AAE" FontSize="12"/></StackPanel>
                <Border DockPanel.Dock="Right" Background="#202636" CornerRadius="14" Padding="12,6" VerticalAlignment="Center"><TextBlock x:Name="HeaderStatusText" Text="READY" Foreground="#B8C1D1" FontSize="12" FontWeight="SemiBold"/></Border>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22">
                <TextBlock Text="Recorder" Foreground="White" FontWeight="SemiBold" FontSize="19"/>
                <TextBlock Text="The screen master stays untouched. Cursor, clicks, shortcuts and smart UI focus rectangles are saved separately so every zoom/effect remains editable." Foreground="#9EA8B9" TextWrapping="Wrap" Margin="0,6,0,18"/>
                <Border Background="#141922" BorderBrush="#293140" BorderThickness="1" CornerRadius="10" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Project folder" Foreground="#DCE1E9" VerticalAlignment="Center"/>
                        <TextBox x:Name="OutputFolderTextBox" Grid.Row="0" Grid.Column="1"/>
                        <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Click="Browse_Click"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Capture quality" Foreground="#DCE1E9" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <ComboBox x:Name="QualityComboBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="0" Margin="4,12,4,4">
                            <ComboBoxItem Content="Lossless Master — FFV1 / MKV (recommended)"/><ComboBoxItem Content="Lossless RGB — H.264 RGB CRF 0 / MKV"/>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Frame rate" Foreground="#DCE1E9" VerticalAlignment="Center" Margin="0,12,0,0"/>
                        <ComboBox x:Name="FpsComboBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" SelectedIndex="1" Margin="4,12,4,4"><ComboBoxItem Content="30"/><ComboBoxItem Content="60"/><ComboBoxItem Content="120"/></ComboBox>
                    </Grid>
                </Border>

                <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Button x:Name="RecordButton" Grid.Column="0" Content="●  RECORD CLEAN MASTER" FontWeight="Bold" FontSize="14" Padding="20,14" Click="Record_Click" Background="#6E51E8" BorderBrush="#8C75FF"/>
                    <Button x:Name="StopButton" Grid.Column="1" Content="■  STOP &amp; SAVE" FontWeight="Bold" FontSize="14" Padding="20,14" IsEnabled="False" Click="Stop_Click"/>
                </Grid>

                <Border Margin="0,18,0,0" Background="#141922" BorderBrush="#293140" BorderThickness="1" CornerRadius="10" Padding="18">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Session" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="OpenEditorButton" Content="Open Motion Editor" IsEnabled="False" Click="OpenEditor_Click" Background="#315C50" BorderBrush="#3E7A69"/>
                                <Button x:Name="OpenFolderButton" Content="Open project folder" IsEnabled="False" Click="OpenFolder_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="SessionPathText" Text="No recording yet." Foreground="#9EA7B7" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="RecorderLogText" Text="FFmpeg has not started." Foreground="#727C8E" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Margin="0,8,0,0" MaxHeight="75"/>
                    </StackPanel>
                </Border>

                <Border Margin="0,18,0,0" Background="#111722" CornerRadius="10" Padding="15">
                    <TextBlock Foreground="#9FAABC" TextWrapping="Wrap"><Run Text="Phase focus: "/><Run FontWeight="Bold" Foreground="White" Text="Auto Zoom + 3D + Cursor Effects + Spotlight/Privacy Blur."/><Run Text=" After recording, open Motion Editor to drag/resize zooms, change focus, easing, 3D controls, cursor style and privacy effects."/></TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#131821" BorderBrush="#272F3D" BorderThickness="0,1,0,0" Padding="24,11"><TextBlock Text="AROSOFT Innovations Ltd · AROMOTION Studio" Foreground="#697386" FontSize="11"/></Border>
    </Grid>
</Window>
